{
  "name": "smart-tv-mcp",
  "version": "0.1.0",
  "description": "Minimal MCP server: YouTube smart-TV agent (personalized recs + research) for Claude Code",
  "type": "module",
  "private": true,
  "bin": { "smart-tv-mcp": "dist/index.js" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "npx -y @modelcontextprotocol/inspector --cli node dist/index.js --method tools/list"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "youtubei.js": "^18.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
